{
  "name": "@ai.assistant/rpc",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/olavoasantos/ai.assistant.git",
    "directory": "ecosystem/sources/rpc/rpc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins/preact-signal": {
      "types": "./dist/plugins/preact-signal/index.d.ts",
      "import": "./dist/plugins/preact-signal/index.js",
      "require": "./dist/plugins/preact-signal/index.cjs"
    },
    "./plugins/callback": {
      "types": "./dist/plugins/callback/index.d.ts",
      "import": "./dist/plugins/callback/index.js",
      "require": "./dist/plugins/callback/index.cjs"
    },
    "./plugins/collections": {
      "types": "./dist/plugins/collections/index.d.ts",
      "import": "./dist/plugins/collections/index.js",
      "require": "./dist/plugins/collections/index.cjs"
    },
    "./register": "./dist/register.d.ts"
  },
  "scripts": {
    "build": "vite build && cp src/register.d.ts dist/register.d.ts",
    "check": "run-p *:check",
    "clean": "rm -rf dist node_modules .testing",
    "dev": "vite build --watch",
    "docs:generate": "node --experimental-strip-types --experimental-transform-types --no-warnings node_modules/@local.pkg/generate-reference-docs/src/cli.ts",
    "fix": "run-p *:fix",
    "format:check": "oxfmt -c .prettierrc.mjs --check src/",
    "format:fix": "oxfmt -c .prettierrc.mjs --write src/",
    "lint:check": "oxlint -c oxlint.json src/",
    "lint:fix": "oxlint -c oxlint.json --fix src/",
    "test:check": "run-p test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:performance": "vitest bench --config vitest.bench.config.ts",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals-core": "catalog:"
  },
  "devDependencies": {
    "@ai.assistant/contracts": "workspace:*",
    "@local.pkg/config": "workspace:*",
    "@local.pkg/generate-reference-docs": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "catalog:",
    "npm-run-all": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "^1.60.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
